{
	"name": "hotpot-agent",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"bench": "tsx packages/benchmarks/src/cli.ts",
		"build": "pnpm --filter @hotpot/web build && pnpm --filter hotpot-agent build",
		"dev": "tsx scripts/dev.ts",
		"pack:npm": "pnpm build && rm -rf artifacts && pnpm --dir packages/hotpot-agent pack --pack-destination ../../artifacts",
		"publish:npm": "pnpm pack:npm && npm publish ./artifacts/hotpot-agent-*.tgz --access public",
		"test": "vitest run",
		"check": "biome check .",
		"typecheck": "pnpm -r exec tsc -p ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3"
	}
}
