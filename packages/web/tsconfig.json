{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// vite 惯例：bundler 解析 + react-jsx；DOM lib 供浏览器 API 类型
		"jsx": "react-jsx",
		"lib": ["es2023", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		// 与 vite.config.ts 的 resolve.alias 同步：shadcn/ui 组件用 @/ 引用 src/
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "test"]
}
